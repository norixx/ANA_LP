<div class="ats-mv">
  <div class="ats-mv__container">
    <div class="ats-mv__container-col">
      <h1 class=" ats-mv__logo">
        <img src="src/img/logo.svg" alt="国内線航空券TIME SALE!!">
      </h1>
      <dl class="ats-mv__sale-period">
        <dt>販売期間</dt>
        <dd>
          <span class="ats-mv__sale-date">
            2026/<span class="ats-mv__sale-date-num">5</span>/<span class="ats-mv__sale-date-num">12</span>［月］〜
            <span class="ats-mv__sale-date-num">5</span>/<span class="ats-mv__sale-date-num">17</span>［金］
          </span>
        </dd>
      </dl>
      <dl class="ats-mv__sale-countdown">
        <dt class="ats-mv__sale-countdown-title">セール終了まであと</dt>
        <dd class="ats-mv__sale-countdown-desc">
          <div class="ats-mv__sale-countdown-box">
            <span class="ats-mv__sale-countdown-num js-sale-countdown-day">99</span>
            <span class="ats-mv__sale-countdown-label">日</span>
          </div>
          <div class="ats-mv__sale-countdown-box">
            <span class="ats-mv__sale-countdown-num js-sale-countdown-hour">12</span>
            <span class="ats-mv__sale-countdown-label">時間</span>
          </div>
          <div class="ats-mv__sale-countdown-box">
            <span class="ats-mv__sale-countdown-num js-sale-countdown-minute">59</span>
            <span class="ats-mv__sale-countdown-label">分</span>
          </div>
        </dd>
      </dl>
    </div>
    <div class="ats-mv__container-col">
      <div class="ats-mv__boarding-period">
        <dl class="ats-mv__boarding-period-title">
          <dt>搭乗期間</dt>
          <dd>
            2026/<span class="ats-mv__boarding-period-date">6</span>/<span
              class="ats-mv__boarding-period-date">12</span>［月］〜 <span
              class="ats-mv__boarding-period-date">7</span>/<span class="ats-mv__boarding-period-date">12</span>［月］
          </dd>
        </dl>
        <div class="ats-mv__boarding-plan">
          <div class="ats-mv__boarding-section">
            <div class="ats-mv__boarding-depart">
              <span class="ats-mv__boarding-area">東京</span>
              <span class="ats-mv__boarding-airport">羽田</span>
            </div>
            <div class="ats-mv__boarding-arrow"></div>
            <div class="ats-mv__boarding-arrive">
              <span class="ats-mv__boarding-area">沖縄</span>
              <span class="ats-mv__boarding-airport">那覇</span>
            </div>
          </div>
          <div class="ats-mv__boarding-price">
            <span class="ats-mv__boarding-price-num">20,460</span>
            <span class="ats-mv__boarding-price-label">円～</span>
          </div>
        </div>
        <div class="ats-mv__boarding-plan">
          <div class="ats-mv__boarding-section">
            <div class="ats-mv__boarding-depart">
              <span class="ats-mv__boarding-area">東京</span>
              <span class="ats-mv__boarding-airport">羽田</span>
            </div>
            <div class="ats-mv__boarding-arrow"></div>
            <div class="ats-mv__boarding-arrive">
              <span class="ats-mv__boarding-area">沖縄</span>
              <span class="ats-mv__boarding-airport">那覇</span>
            </div>
          </div>
          <div class="ats-mv__boarding-price">
            <span class="ats-mv__boarding-price-num">20,460</span>
            <span class="ats-mv__boarding-price-label">円～</span>
          </div>
        </div>

        <div class="ats-mv__boarding-price-cta mt-4">
          <a href="#"
            class="ats-c-btn ats-c-btn--accent-orange ats-c-btn--lg ats-c-btn--w-full ats-c-btn--i-r-arrow-down">
            <span class="ats-c-btn__content-fill">その他の路線・詳細はこちら</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>